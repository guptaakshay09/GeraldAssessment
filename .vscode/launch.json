    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": ".NET Core Launch (RagKnowledgeService)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/RagKnowledgeService/bin/Debug/net8.0/RagKnowledgeService.dll",
            "args": [],
            "cwd": "${workspaceFolder}/RagKnowledgeService",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}